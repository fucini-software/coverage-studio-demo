:28}},"status":"Killed","static":false,"coveredBy":["783779ee-b280-ead1-0dc1-57b7d27a7526"],"killedBy":["783779ee-b280-ead1-0dc1-57b7d27a7526"]},{"id":"60","mutatorName":"String mutation","replacement":"$\u0022\u0022","location":{"start":{"line":157,"column":65},"end":{"line":157,"column":86}},"status":"NoCoverage","statusReason":"Not covered by any test.","static":false,"coveredBy":[],"killedBy":[]},{"id":"61","mutatorName":"String mutation","replacement":"$\u0022\u0022","location":{"start":{"line":162,"column":71},"end":{"line":162,"column":89}},"status":"Ignored","statusReason":"Removed by exclude from code coverage filter","static":false,"coveredBy":[],"killedBy":[]}]}},"projectRoot":"/work/samples/dotnet/src/Pricing","schemaVersion":"2","testFiles":{"/work/samples/dotnet/test/Pricing.Tests/QuoteTests.cs":{"language":"cs","source":"// \u003Ccopyright file=\u0022QuoteTests.cs\u0022 company=\u0022Fucini Consulting\u0022\u003E\n// Copyright (c) 2026 Fucini Consulting. Released under the MIT License; see the\n// LICENSE file in the repository root.\n// \u003C/copyright\u003E\n// \u003Cauthor\u003EMario Fucini\u003C/author\u003E\n\nusing Xunit;\n\nnamespace Pricing.Tests;\n\n/// \u003Csummary\u003E\n/// The test suite of the .NET coverage sample. What it never passes in is\n/// deliberate, and is documented on the method it belongs to in Quote.cs.\n/// The shipping tests are in \u003Csee cref=\u0022ShippingTests\u0022/\u003E, so that the\n/// per-test reports have two classes to tell apart.\n/// \u003C/summary\u003E\npublic class QuoteTests\n{\n    /// \u003Csummary\u003EThe one path through \u003Csee cref=\u0022Quote.Price\u0022/\u003E the suite knows.\u003C/summary\u003E\n    [Fact]\n    public void AGoldCustomerGetsTenPercent() =\u003E\n        Assert.Equal(90m, Quote.Price(100m, new Customer(Tier.Gold, Years: 2), lines: 2));\n\n    /// \u003Csummary\u003ENever a price below the minimum: the guard\u0027s return never runs.\u003C/summary\u003E\n    [Fact]\n    public void APriceAboveTheMinimumIsKept() =\u003E\n        Assert.Equal(12m, Quote.AtLeast(12m, 5m));\n\n    /// \u003Csummary\u003EOnly ever Switzerland: the other arm of the ternary never runs.\u003C/summary\u003E\n    [Fact]\n    public void VatIsAddedForSwitzerland() =\u003E\n        Assert.Equal(108.1m, Quote.WithVat(100m, \u0022CH\u0022));\n}\n","tests":[{"id":"e79a9fdc-2bb5-6759-fd53-0bcef4eaf806","name":"Pricing.Tests.QuoteTests.AGoldCustomerGetsTenPercent","location":{"start":{"line":20,"column":5},"end":{"line":22,"column":91}}},{"id":"783779ee-b280-ead1-0dc1-57b7d27a7526","name":"Pricing.Tests.QuoteTests.APriceAboveTheMinimumIsKept","location":{"start":{"line":25,"column":5},"end":{"line":27,"column":51}}},{"id":"bf396a63-eb8e-2eb1-c1af-0a02eb8e9af2","name":"Pricing.Tests.QuoteTests.VatIsAddedForSwitzerland","location":{"start":{"line":30,"column":5},"end":{"line":32,"column":57}}}]},"/work/samples/dotnet/test/Pricing.Tests/ShippingTests.cs":{"language":"cs","source":"// \u003Ccopyright file=\u0022ShippingTests.cs\u0022 company=\u0022Fucini Consulting\u0022\u003E\n// Copyright (c) 2026 Fucini Consulting. Released under the MIT License; see the\n// LICENSE file in the repository root.\n// \u003C/copyright\u003E\n// \u003Cauthor\u003EMario Fucini\u003C/author\u003E\n\nusing Xunit;\n\nnamespace Pricing.Tests;\n\n/// \u003Csummary\u003E\n/// The shipping tests, in a class of their own: a second test class is what\n/// makes the per-test reports (\u003Cc\u003Ecoverage/per-test/\u003C/c\u003E) say something \u2014\n/// \u003Cem\u003EShow Tests That Ran This Line\u003C/em\u003E names this class on\n/// \u003Csee cref=\u0022Quote.Shipping\u0022/\u003E and \u003Csee cref=\u0022QuoteTests\u0022/\u003E on\n/// \u003Csee cref=\u0022Quote.Price\u0022/\u003E.\n/// \u003C/summary\u003E\npublic class ShippingTests\n{\n    /// \u003Csummary\u003EEvery kind of delivery, in both weight bands.\u003C/summary\u003E\n    /// \u003Cparam name=\u0022kind\u0022\u003EKind of delivery.\u003C/param\u003E\n    /// \u003Cparam name=\u0022weightKg\u0022\u003EParcel weight.\u003C/param\u003E\n    /// \u003Cparam name=\u0022expected\u0022\u003EThe charge.\u003C/param\u003E\n    [Theory]\n    [InlineData(\u0022standard\u0022, 1, 4.9)]\n    [InlineData(\u0022standard\u0022, 25, 9.8)]\n    [InlineData(\u0022express\u0022, 1, 12)]\n    [InlineData(\u0022express\u0022, 25, 24)]\n    [InlineData(\u0022pickup\u0022, 1, 0)]\n    [InlineData(\u0022freight\u0022, 400, 80)]\n    public void ShippingKnowsEveryKind(string kind, double weightKg, double expected) =\u003E\n        Assert.Equal((decimal)expected, Quote.Shipping(kind, (decimal)weightKg));\n\n    /// \u003Csummary\u003EThe fallback of \u003Csee cref=\u0022Quote.Shipping\u0022/\u003E is tested too.\u003C/summary\u003E\n    [Fact]\n    public void UnknownDeliveryIsRefused() =\u003E\n        Assert.Throws\u003CArgumentException\u003E(() =\u003E Quote.Shipping(\u0022drone\u0022, 1m));\n}\n","tests":[{"id":"b7b7e5f4-8c66-dd92-88f1-fe73e2e31ac2","name":"Pricing.Tests.ShippingTests.ShippingKnowsEveryKind","location":{"start":{"line":24,"column":5},"end":{"line":32,"column":82}}},{"id":"85218146-2f26-68bd-821b-32641abc95f5","name":"Pricing.Tests.ShippingTests.ShippingKnowsEveryKind","location":{"start":{"line":24,"column":5},"end":{"line":32,"column":82}}},{"id":"5c48e591-a85b-473a-1fab-961b0ade98c8","name":"Pricing.Tests.ShippingTests.ShippingKnowsEveryKind","location":{"start":{"line":24,"column":5},"end":{"line":32,"column":82}}},{"id":"8eec2253-3dea-a9c8-79f5-474e668ef409","name":"Pricing.Tests.ShippingTests.ShippingKnowsEveryKind","location":{"start":{"line":24,"column":5},"end":{"line":32,"column":82}}},{"id":"3000e309-988e-b883-1787-2d3f31fa5f5c","name":"Pricing.Tests.ShippingTests.ShippingKnowsEveryKind","location":{"start":{"line":24,"column":5},"end":{"line":32,"column":82}}},{"id":"1713932b-52a4-747a-90f6-9c00f17b1e04","name":"Pricing.Tests.ShippingTests.ShippingKnowsEveryKind","location":{"start":{"line":24,"column":5},"end":{"line":32,"column":82}}},{"id":"c71377b9-ebef-389d-ee78-7945a8f0d5af","name":"Pricing.Tests.ShippingTests.UnknownDeliveryIsRefused","location":{"start":{"line":35,"column":5},"end":{"line":37,"column":77}}}]}},"thresholds":{"high":80,"low":60}}