{
  // .NET sample settings for Fucini Coverage Studio.

  "fuciniCoverage.coverageFile.defaultLocation": "${workspaceFolder}/coverage",
  // Coverlet's OpenCover output rather than its Cobertura: it keeps a visit
  // count per branch arm, where Cobertura flattens a decision into "50% (1/2)".
  // Both carry the per-method cyclomatic complexity that the CRAP score and the
  // Riskiest Methods table are computed from.
  // Not in the list on purpose: the per-test reports, one per test class, for
  // "Show Tests That Ran This Line". Add
  // "${workspaceFolder}/coverage/per-test/**/coverage.cobertura.xml" when you
  // want them — '**' stands for any depth, and a report written under that
  // folder later loads as it lands (Coverage Studio 1.2026.6 or later) — so
  // the numbers above stand alone until then (see README.md).
  "fuciniCoverage.coverageFile.paths": ["coverage.opencover.xml"],
  // The reports were generated in the lab image, where this repository is
  // mounted at /work. This maps that prefix back to wherever you cloned it.
  "fuciniCoverage.pathRemap": [{ "from": "/work/samples/dotnet", "to": "${workspaceRoot}" }],
  // What ran, how often, and what never did, on a first open of Quote.cs — as
  // in the C, C++ and TypeScript samples. By default the margin shows findings
  // only, and a first open of an under-tested file would show nothing.
  "fuciniCoverage.editorGutter.mode": "heatmap",
  "fuciniCoverage.hitCounts.inline": true,
  "fuciniCoverage.watch.enabled": true,
  "fuciniCoverage.history.enabled": true
}
