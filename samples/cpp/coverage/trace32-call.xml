<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!--
  ILLUSTRATIVE, not an export from a TRACE32 session.

  Written by hand in the schema of Lauterbach's COVerage.EXPORT.ListModule, with
  the counts reasoned from the sources: gearbox.cpp has two call sites, the
  clamp_to<int> call in next_gear(), which the tests exercise, and the
  clamp_to<double> call in fuel_ratio(), which they never reach. It is here so
  the sample can show call coverage beside the compiler's metrics; a real
  export from the TRACE32 simulator is to replace it. See ../README.md.

  TRACE32 names modules, not files: .vscode/settings.json maps the module
  "gearbox" to src/gearbox.cpp with a fuciniCoverage.pathRemap rule.
-->
<TRACE32 file="coverage/trace32-call.xml">
	<coverage>
		<COVerage.EXPORT.ListModule metric="call">
			<module>
				<tree>\\gearbox_demo\gearbox</tree>
				<exec metric="call">50.000%</exec>
				<calls>2</calls>
				<callsok>1</callsok>
			</module>
		</COVerage.EXPORT.ListModule>
	</coverage>
</TRACE32>
