{
  // Python sample settings for Fucini Coverage Studio.

  "fuciniCoverage.coverageFile.defaultLocation": "${workspaceFolder}/coverage",
  // coverage.py's own JSON rather than the Cobertura or LCOV written from the
  // same run: it keeps `# pragma: no cover` lines as excluded instead of
  // dropping them, and it says which way each branch went.
  "fuciniCoverage.coverageFile.paths": ["coverage.json"],
  // The reports were generated in the lab image, where this repository is
  // mounted at /work. This maps that prefix back to wherever you cloned it.
  "fuciniCoverage.pathRemap": [{ "from": "/work/samples/python", "to": "${workspaceFolder}" }],
  // ledger/archive.py is imported by nothing, so no report mentions it.
  "fuciniCoverage.unmeasured.mode": "list",
  "fuciniCoverage.watch.enabled": true,
  "fuciniCoverage.history.enabled": true
}
