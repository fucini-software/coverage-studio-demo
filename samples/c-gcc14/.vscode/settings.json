{
  // Condition-coverage sample settings for Fucini Coverage Studio.

  "fuciniCoverage.coverageFile.defaultLocation": "${workspaceFolder}/coverage",
  // gcov writes one JSON per translation unit it is asked about, named after
  // the source; the wildcard takes whatever is there, and a report written
  // later loads as it lands.
  "fuciniCoverage.coverageFile.paths": ["${workspaceFolder}/coverage/*.gcov.json.gz"],
  // The committed report was written in the lab image, where this repository
  // is mounted at /work. This maps that prefix back to wherever you cloned it.
  "fuciniCoverage.pathRemap": [{ "from": "/work/samples/c-gcc14", "to": "${workspaceRoot}" }],
  // Red, amber and green in the gutter from the first open, with the hit count
  // after each line: a decision taken both ways is green, and the condition
  // mark on it is what this sample is about.
  "fuciniCoverage.editorGutter.mode": "coverage",
  "fuciniCoverage.hitCounts.inline": true,
  "fuciniCoverage.watch.enabled": true
}
