# Build outputs of every sample. The coverage reports under samples/*/coverage
# are the point of this repository and are committed on purpose.
build/
bin/
obj/
target/
node_modules/
__pycache__/
*.gcda
*.gcno
*.profraw
*.profdata
.nyc_output/

# What Visual Studio keeps beside a folder or a solution it has opened, and
# where its CMake support builds.
.vs/
out/
*.user

# What "Run Native Project with Coverage" writes for samples/cpp/Gearbox.sln:
# an instrumented build, its profile and the lcov export — this machine's,
# made again on every run.
**/coverage/native/
