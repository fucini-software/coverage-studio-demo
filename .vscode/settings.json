{
  // Settings for opening the repository root: they show the C sample, the way
  // this repository always has. Each folder under samples/ has settings of its
  // own, and coverage-studio-demo.code-workspace opens them all side by side.

  // Base folder for coverage discovery (${workspaceFolder} supported) — set
  // so coverage.json/lcov.info here are found without scanning the whole
  // workspace root.
  "fuciniCoverage.coverageFile.defaultLocation": "${workspaceFolder}/samples/c/coverage",
  // Load the ready-made llvm-cov JSON so gutters/CodeLens/report appear
  // immediately, no "Load Coverage" step needed on first open.
  //
  // coverage.json rather than lcov.info because LCOV cannot carry regions,
  // instantiations or MC/DC — and MC/DC is the whole point of `buffer.c`'s
  // `buffer_can_write`, which every other metric reports as healthy. Both
  // files come from the same build (see scripts/gen-coverage), so switching
  // this to ["lcov.info"] shows the same code measured the poorer way.
  //
  // Since Coverage Studio 1.2026.6 an entry may be absolute and hold a
  // wildcard: '*' stands for part of one name, '**' for any depth, the folders
  // before the first wildcard are where it looks, and a matching report that
  // appears there later is loaded as it lands. One such entry would load
  // every sample that writes a coverage.json — C, C++ and Python — with the
  // lab's /work prefix mapped back to this checkout:
  //   "fuciniCoverage.coverageFile.paths": ["${workspaceFolder}/samples/*/coverage/coverage.json"],
  //   "fuciniCoverage.pathRemap": [{ "from": "/work", "to": "${workspaceRoot}" }],
  // Not set here, so that the root keeps showing the C sample alone; the
  // samples' own settings use such entries where a folder holds several
  // reports (c-cross-check, and the per-suite alternatives in js, ts, python
  // and dotnet).
  "fuciniCoverage.coverageFile.paths": ["coverage.json"],
  // Auto-reload when a tracefile here changes — handy while re-running
  // scripts/gen-coverage.(sh|ps1) to try a different compiler.
  "fuciniCoverage.watch.enabled": true,
  // Store runs as JSON so "Compare with Last Run" has something to diff,
  // useful for demoing the history/trend features.
  "fuciniCoverage.history.enabled": true,
  // Show the MC/DC decision-coverage gutter bar — off by default in real
  // projects, on here so the demo showcases it without extra clicks.
  "fuciniCoverage.mcdcGutter.enabled": true,
  // Since 0.2026.69 the editor gutter shows only findings by default
  // (since-last-run marks, edited-line dots, MC/DC bars) and nothing on a
  // plainly covered or uncovered line — the colour-coded view lives in the
  // Annotated Source. The demo turns the gutter's heatmap on and puts the
  // hit count after each line, so a first open of calc.c shows what ran,
  // how often, and what never did. "uncovered" is the calmer alternative:
  // bars on never-run lines only.
  "fuciniCoverage.editorGutter.mode": "heatmap",
  "fuciniCoverage.hitCounts.inline": true,
  // CMakeLists.txt lives with the C sample since the repository holds one
  // sample per language; this tells CMake Tools where, on any machine.
  "cmake.sourceDirectory": "${workspaceFolder}/samples/c"
}
