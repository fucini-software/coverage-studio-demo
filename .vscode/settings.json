{
  // Demo workspace settings for Fucini Coverage Studio.

  // Base folder for coverage discovery (${workspaceFolder} supported) — set
  // so coverage.json/lcov.info here are found without scanning the whole
  // workspace root.
  "fuciniCoverage.coverageFile.defaultLocation": "${workspaceFolder}/coverage",
  // Load the ready-made lcov.info so gutters/CodeLens/report appear
  // immediately, no "Load Coverage" step needed on first open.
  "fuciniCoverage.coverageFile.paths": ["lcov.info"],
  // Auto-reload when a tracefile here changes — handy while re-running
  // scripts/gen-coverage.(sh|ps1) to try a different compiler.
  "fuciniCoverage.watch.enabled": true,
  // Store runs as JSON so "Compare with Last Run" has something to diff,
  // useful for demoing the history/trend features.
  "fuciniCoverage.history.enabled": true,
  // Show the MC/DC decision-coverage gutter bar — off by default in real
  // projects, on here so the demo showcases it without extra clicks.
  "fuciniCoverage.mcdcGutter.enabled": true
}
