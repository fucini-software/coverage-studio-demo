{
  // One folder per language. Each has its own .vscode/settings.json saying
  // which of its reports to load, so every sample works the moment it is
  // opened, here or on its own.
  "folders": [
    { "name": "C (llvm-cov, lcov, MC/DC)", "path": "samples/c" },
    { "name": "C (clang and GCC, two reports combined)", "path": "samples/c-cross-check" },
    { "name": "C++ (one file, every metric)", "path": "samples/cpp" },
    { "name": "C++ (MSVC, Microsoft's collector)", "path": "samples/cpp-msvc" },
    { "name": "JavaScript (Istanbul)", "path": "samples/js" },
    { "name": "TypeScript (vitest + Istanbul)", "path": "samples/ts" },
    { "name": "Python (coverage.py)", "path": "samples/python" },
    { "name": ".NET (Coverlet, dotnet-coverage)", "path": "samples/dotnet" },
    { "name": "Visual Basic (Coverlet)", "path": "samples/vb" }
  ],
  "settings": {
    "fuciniCoverage.watch.enabled": true,
    "fuciniCoverage.history.enabled": true,
    "fuciniCoverage.telemetry.enabled": false,
    "fuciniCoverage.telemetry.developerMode": false
  },
  "extensions": {
    "recommendations": ["fucini-software.coverage-studio-vscode"]
  }
}
